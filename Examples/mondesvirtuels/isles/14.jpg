<li class="blocks-gallery-item"><a href="https://www.mondesvirtuels.com/arbres/" class="custom-link no-lightbox" onclick="event.stopPropagation()" target="_self" rel="" aria-label=""><figure><img width="600" height="282"  alt="" data-id="292" data-full-url="https://www.mondesvirtuels.com/fr/wp-content/uploads/2021/06/arbres_600x282.jpg" data-link="https://www.mondesvirtuels.com/fr/arbres_600x282/"  data-srcset="https://www.mondesvirtuels.com/fr/wp-content/uploads/2021/06/arbres_600x282.jpg 600w, https://www.mondesvirtuels.com/fr/wp-content/uploads/2021/06/arbres_600x282-300x141.jpg 300w"  data-src="https://www.mondesvirtuels.com/fr/wp-content/uploads/2021/06/arbres_600x282.jpg" data-sizes="(max-width: 600px) 100vw, 600px" class="wp-image-292 lazyload" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="><noscript><img width="600" height="282" src="https://www.mondesvirtuels.com/fr/wp-content/uploads/2021/06/arbres_600x282.jpg" alt="" data-id="292" data-full-url="https://www.mondesvirtuels.com/fr/wp-content/uploads/2021/06/arbres_600x282.jpg" data-link="https://www.mondesvirtuels.com/fr/arbres_600x282/" class="wp-image-292" srcset="https://www.mondesvirtuels.com/fr/wp-content/uploads/2021/06/arbres_600x282.jpg 600w, https://www.mondesvirtuels.com/fr/wp-content/uploads/2021/06/arbres_600x282-300x141.jpg 300w" sizes="(max-width: 600px) 100vw, 600px"></noscript><figcaption class="blocks-gallery-item__caption">Cité des arbres</figcaption></figure></a></li>
